{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc16-debug",
      "displayName": "GCC 16 Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "gcc16-debug", "configurePreset": "gcc16-debug" }
  ]
}
